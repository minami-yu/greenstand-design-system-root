{
  "buildPath": "style-dictionary",
  "platformBuildPaths": {
    "web": "web",
    "android": "android",
    "ios": "ios",
    "reactNative": "react-native"
  },
  "androidCompose": {
    "packageName": "org.greenstand.tokens",
    "className": "Tokens"
  },
  "sources": {
    "colorBase": "design-tokens/variables/token_color-base_value.json",
    "colorLight": "design-tokens/variables/token_color_light.json",
    "colorDark": "design-tokens/variables/token_color_dark.json",
    "size": "design-tokens/variables/token_size_value.json",
    "typographyMobile": "design-tokens/variables/token_typography-base_mobile.json",
    "typographyDesktop": "design-tokens/variables/token_typography-base_desktop.json",
    "typographyStyle": "design-tokens/styles/typography.json",
    "elevationStyle": "design-tokens/styles/elevation.json"
  },
  "source": [
    "design-tokens/variables/**/*.json",
    "design-tokens/styles/**/*.json"
  ]
}
