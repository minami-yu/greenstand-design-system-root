      "600": {
        "$type": "number",
        "$value": 24,
        "$description": "section padding, gap between cards."
      },
      "800": {
        "$type": "number",
        "$value": 32,
        "$description": "large section gap."
      }
    },
    "stroke": {
      "md": {
        "$type": "number",
        "$value": 2,
        "$description": "emphasis border. Focused inputs, selected states."
      },
      "sm": {
        "$type": "number",
        "$value": 1,
        "$description": "Default border. Cards, inputs, dividers."
      }
    }
