        "$description": "extra large icon. Onboarding illustrations."
      },
      "lg": {
        "$type": "number",
        "$value": 24,
        "$description": "standard icon. Tab bar, toolbar, card actions."
      },
      "md": {
        "$type": "number",
        "$value": 20,
        "$description": "default icon. Buttons, nav items, list items."
      },
      "sm": {
        "$type": "number",
        "$value": 16,
        "$description": "small icon. Inline with text, inputs, table rows."
      },
      "xl": {
        "$type": "number",
        "$value": 32,
        "$description": "large icon. Empty states, feature highlights."
      },
      "xs": {
        "$type": "number",
        "$value": 12,
        "$description": "inline icon inside a label or badge."
      }
    },
    "radius": {
      "full": {
        "$type": "number",
        "$value": 9999,
        "$description": "fully rounded. Pills, avatars, toggle switches."
      },
      "lg": {
        "$type": "number",
        "$value": 16,
        "$description": "large rounding. Bottom sheets, modals, dialogs."
      },
      "none": {
        "$type": "number",
        "$value": 0,
        "$description": "no rounding. Dividers, full-width elements."
      },
      "sm": {
        "$type": "number",
        "$value": 8,
        "$description": "Default rounding. Buttons, inputs, cards, menus."
      },
      "xs": {
        "$type": "number",
        "$value": 4,
        "$description": "subtle rounding. Badges, tags, small chips."
      }
    },
    "space": {
      "0": {
        "$type": "number",
        "$value": 0,
        "$description": "no spacing"
      },
      "100": {
        "$type": "number",
        "$value": 4,
        "$description": "icon-to-label gap, tight internal padding."
      },
      "1200": {
        "$type": "number",
        "$value": 48,
        "$description": "section separation on content-heavy screens."
      },
      "1600": {
        "$type": "number",
        "$value": 64,
        "$description": "maximum spacing, page-level vertical rhythm."
      },
      "200": {
        "$type": "number",
        "$value": 8,
        "$description": "compact padding inside components."
      },
      "300": {
        "$type": "number",
