        "$type": "number",
        "$value": 0,
        "$description": "0px — no rounding. Dividers, full-width elements."
      },
      "sm": {
        "$type": "number",
        "$value": 8,
        "$description": "8px — default rounding. Buttons, inputs, cards, menus."
      },
      "xs": {
        "$type": "number",
        "$value": 4,
        "$description": "4px — subtle rounding. Badges, tags, small chips."
      }
    },
    "space": {
      "0": {
        "$type": "number",
        "$value": 0,
        "$description": "0px — no spacing."
      },
      "100": {
        "$type": "number",
        "$value": 4,
