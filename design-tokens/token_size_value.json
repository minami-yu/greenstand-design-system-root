      "xs": {
        "$type": "number",
        "$value": 12,
        "$description": "12px — inline icon inside a label or badge."
      }
    },
    "radius": {
      "full": {
        "$type": "number",
        "$value": 9999,
        "$description": "9999px — fully rounded. Pills, avatars, toggle switches."
