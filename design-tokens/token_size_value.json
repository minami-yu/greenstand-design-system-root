      "1200": {
        "$type": "number",
        "$value": 48,
        "$description": "48px — section separation on content-heavy screens."
      },
      "1600": {
        "$type": "number",
        "$value": 64,
        "$description": "64px — maximum spacing, page-level vertical rhythm."
      },
