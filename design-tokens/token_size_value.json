      "600": {
        "$type": "number",
        "$value": 24,
        "$description": "24px — section padding, gap between cards."
      },
      "800": {
        "$type": "number",
        "$value": 32,
        "$description": "32px — large section gap."
      }
    },
    "stroke": {
      "md": {
        "$type": "number",
        "$value": 2,
        "$description": "2px — emphasis border. Focused inputs, selected states."
      },
      "sm": {
        "$type": "number",
        "$value": 1,
        "$description": "1px — default border. Cards, inputs, dividers."
      }
    }
